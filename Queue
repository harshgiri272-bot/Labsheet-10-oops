import java.util.LinkedList;
import java.util.Queue;

public class PatientQueue {
    // Queue interface reference, LinkedList implementation
    private Queue<Patient> queue = new LinkedList<>();

    public void addPatient(Patient p) {
        queue.add(p);
        System.out.println("Added to queue: " + p.getName() + " (ID " + p.getId() + ")");
    }

    // Serves the patient who has been waiting the longest (FIFO)
    public void servePatient() {
        Patient p = queue.poll();
        if (p == null) {
            System.out.println("No patients waiting.");
        } else {
            System.out.println("Serving: " + p.getName() + " (ID " + p.getId() + ")");
        }
    }

    public void displayWaiting() {
        if (queue.isEmpty()) {
            System.out.println("No patients waiting.");
            return;
        }
        for (Patient p : queue) {
            p.display();
        }
    }
}
public class Patient {
    private int id;
    private String name;

    public Patient(int id, String name) {
        this.id = id;
        this.name = name;
    }

    public int getId() {
        return id;
    }

    public String getName() {
        return name;
    }

    public void display() {
        System.out.println("Patient ID: " + id + ", Name: " + name);
    }
}
// Q9. Patients served in FIFO order using Queue<Patient> backed by LinkedList.
public class Main {
    public static void main(String[] args) {
        PatientQueue clinic = new PatientQueue();

        System.out.println("--- Patients arriving ---");
        clinic.addPatient(new Patient(1, "Ramesh"));
        clinic.addPatient(new Patient(2, "Sita"));
        clinic.addPatient(new Patient(3, "Mohan"));
        clinic.addPatient(new Patient(4, "Geeta"));

        System.out.println("\n--- Waiting list ---");
        clinic.displayWaiting();

        System.out.println("\n--- Serving patients ---");
        clinic.servePatient();
        clinic.servePatient();

        System.out.println("\n--- Waiting list ---");
        clinic.displayWaiting();

        System.out.println("\n--- Serving the rest ---");
        clinic.servePatient();
        clinic.servePatient();
        clinic.servePatient();   // queue is empty now
    }
}
