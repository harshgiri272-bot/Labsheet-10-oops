public class Circle extends Shape {
    private double radius;

    public Circle(double radius) {
        super("Circle");
        this.radius = radius;
    }

    @Override
    public double area() {
        return Math.PI * radius * radius;
    }

    @Override
    public void display() {
        System.out.printf("Circle with radius %.2f -> Area = %.2f%n", radius, area());
    }
}
public class Shape {
    protected String name;

    public Shape(String name) {
        this.name = name;
    }

    // Overridden by subclasses
    public double area() {
        return 0.0;
    }

    public void display() {
        System.out.println("Shape: " + name + ", Area: " + area());
    }
}
import java.util.ArrayList;

// Q6. Circle objects stored in an ArrayList<Shape> (polymorphism).
public class Main {
    public static void main(String[] args) {
        ArrayList<Shape> shapes = new ArrayList<>();
        shapes.add(new Circle(1.0));
        shapes.add(new Circle(2.5));
        shapes.add(new Circle(5.0));
        shapes.add(new Circle(7.2));

        System.out.println("Areas of all circles:");
        for (Shape s : shapes) {
            s.display();   // calls Circle's overridden display() and area()
        }
    }
}
